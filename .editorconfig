# EditorConfig — https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2

# Markdown: trailing double-space is a hard line break — do not strip it.
[*.md]
trim_trailing_whitespace = false
max_line_length = off

[*.{yml,yaml,json,toml}]
indent_size = 2

[Makefile]
indent_style = tab
